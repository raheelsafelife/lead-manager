# Rebuilt Lead Manager API
LEAD_MANAGER_API_KEY=<generate-a-long-random-secret>

# AWS PostgreSQL deployment
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
JWT_SECRET_KEY=<generate-a-separate-long-random-secret>

# Optional strict AI planner/humanizer for the chatbot.
# Keep the API key only in your real .env file, never commit it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini,gpt-4.1-mini,gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=180
OPENAI_VERBOSITY=medium
